# reqpeek env example — copy to .env and adjust.

# listen address (public origin)
HOST=0.0.0.0
PORT=3000

# 回源 token 门禁：非空则强制校验 x-origin-token，不匹配返回 403 极简页
ORIGIN_TOKEN=

# 影响框架层 request.protocol/hostname；界面展示一律以自推导 + 标注信源为准
TRUST_PROXY=1

# 接收 body 上限
BODY_LIMIT=1mb

# 展示文本截断上限
DISPLAY_LIMIT=256kb

# none | partial | strict
MASK_MODE=partial

# off | on（on 时 60 req/min per socket IP）
RATE_LIMIT=off

# 只打启动与错误
LOG_LEVEL=warn
